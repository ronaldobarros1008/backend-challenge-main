      "checks": [
        {
          "name": "ck_wager_amount_positive",
          "expression": "amount > 0",
          "definition": "CHECK ((amount > (0)::numeric))",
          "columnName": "amount"
        },
        {
          "name": "ck_wager_amount_scale",
          "expression": "amount = round(amount, 2)",
          "definition": "CHECK ((amount = round(amount, 2)))",
          "columnName": "amount"
        },
        {
          "name": "ck_wager_balance_after_non_negative",
          "expression": "(balance_after IS NULL) OR (balance_after >= 0)",
          "definition": "CHECK (((balance_after IS NULL) OR (balance_after >= (0)::numeric)))",
          "columnName": "balance_after"
        },
        {
          "name": "ck_wager_balance_after_scale",
          "expression": "(balance_after IS NULL) OR (balance_after = round(balance_after, 2))",
          "definition": "CHECK (((balance_after IS NULL) OR (balance_after = round(balance_after, 2))))",
          "columnName": "balance_after"
        },
        {
          "name": "ck_wager_currency",
          "expression": "currency ~ '^[A-Z]{3}$'::text",
          "definition": "CHECK ((currency ~ '^[A-Z]{3}$'::text))",
          "columnName": "currency"
        },
        {
          "name": "ck_wager_external_id_not_blank",
          "expression": "length(TRIM(BOTH FROM external_transaction_id)) > 0",
          "definition": "CHECK ((length(TRIM(BOTH FROM external_transaction_id)) > 0))",
          "columnName": "external_transaction_id"
        },
        {
          "name": "ck_wager_game_id_not_blank",
          "expression": "length(TRIM(BOTH FROM game_id)) > 0",
          "definition": "CHECK ((length(TRIM(BOTH FROM game_id)) > 0))",
          "columnName": "game_id"
        },
        {
          "name": "ck_wager_idempotency_key_not_blank",
          "expression": "length(TRIM(BOTH FROM idempotency_key)) > 0",
          "definition": "CHECK ((length(TRIM(BOTH FROM idempotency_key)) > 0))",
          "columnName": "idempotency_key"
        },
        {
          "name": "ck_wager_next_reference_attempt",
          "expression": "(status = 'PENDING_REFERENCE'::wager_transaction_status) OR (next_reference_attempt_at IS NULL)",
          "definition": "CHECK (((status = 'PENDING_REFERENCE'::wager_transaction_status) OR (next_reference_attempt_at IS NULL)))",
          "columnName": "next_reference_attempt_at"
        },
        {
          "name": "ck_wager_payload_hash",
          "expression": "payload_hash ~ '^[0-9a-f]{64}$'::text",
          "definition": "CHECK ((payload_hash ~ '^[0-9a-f]{64}$'::text))",
          "columnName": "payload_hash"
        },
        {
          "name": "ck_wager_pending_reference_kind",
          "expression": "(status <> 'PENDING_REFERENCE'::wager_transaction_status) OR (kind = ANY (ARRAY['REFUND'::wager_transaction_kind, 'ROLLBACK'::wager_transaction_kind]))",
          "definition": "CHECK (((status <> 'PENDING_REFERENCE'::wager_transaction_status) OR (kind = ANY (ARRAY['REFUND'::wager_transaction_kind, 'ROLLBACK'::wager_transaction_kind]))))",
          "columnName": "kind"
        },
        {
          "name": "ck_wager_processed_at",
          "expression": "(processed_at IS NULL) OR (processed_at >= created_at)",
          "definition": "CHECK (((processed_at IS NULL) OR (processed_at >= created_at)))",
          "columnName": "created_at"
        },
        {
          "name": "ck_wager_processed_reference",
          "expression": "(status <> 'PROCESSED'::wager_transaction_status) OR (kind <> ALL (ARRAY['REFUND'::wager_transaction_kind, 'ROLLBACK'::wager_transaction_kind])) OR (reference_transaction_id IS NOT NULL)",
          "definition": "CHECK (((status <> 'PROCESSED'::wager_transaction_status) OR (kind <> ALL (ARRAY['REFUND'::wager_transaction_kind, 'ROLLBACK'::wager_transaction_kind])) OR (reference_transaction_id IS NOT NULL)))",
          "columnName": "kind"
        },
        {
          "name": "ck_wager_provider_not_blank",
          "expression": "length(TRIM(BOTH FROM provider_id)) > 0",
          "definition": "CHECK ((length(TRIM(BOTH FROM provider_id)) > 0))",
          "columnName": "provider_id"
        },
        {
          "name": "ck_wager_reference_attempts",
          "expression": "reference_attempts >= 0",
          "definition": "CHECK ((reference_attempts >= 0))",
          "columnName": "reference_attempts"
        },
        {
          "name": "ck_wager_reference_external_by_kind",
          "expression": "((kind = ANY (ARRAY['REFUND'::wager_transaction_kind, 'ROLLBACK'::wager_transaction_kind])) AND (reference_external_transaction_id IS NOT NULL) AND (length(TRIM(BOTH FROM reference_external_transaction_id)) > 0)) OR (kind = 'WIN'::wager_transaction_kind) OR ((kind = ANY (ARRAY['OPENING'::wager_transaction_kind, 'BET'::wager_transaction_kind, 'LOSS'::wager_transaction_kind])) AND (reference_external_transaction_id IS NULL))",
          "definition": "CHECK ((((kind = ANY (ARRAY['REFUND'::wager_transaction_kind, 'ROLLBACK'::wager_transaction_kind])) AND (reference_external_transaction_id IS NOT NULL) AND (length(TRIM(BOTH FROM reference_external_transaction_id)) > 0)) OR (kind = 'WIN'::wager_transaction_kind) OR ((kind = ANY (ARRAY['OPENING'::wager_transaction_kind, 'BET'::wager_transaction_kind, 'LOSS'::wager_transaction_kind])) AND (reference_external_transaction_id IS NULL))))",
          "columnName": "kind"
        },
        {
          "name": "ck_wager_round_id_not_blank",
          "expression": "length(TRIM(BOTH FROM round_id)) > 0",
          "definition": "CHECK ((length(TRIM(BOTH FROM round_id)) > 0))",
          "columnName": "round_id"
        },
        {
          "name": "ck_wager_status_metadata",
          "expression": "((status = 'PROCESSED'::wager_transaction_status) AND (processed_at IS NOT NULL) AND (failure_code IS NULL)) OR ((status = ANY (ARRAY['REJECTED'::wager_transaction_status, 'FAILED'::wager_transaction_status])) AND (processed_at IS NULL) AND (failure_code IS NOT NULL)) OR ((status = ANY (ARRAY['PENDING'::wager_transaction_status, 'PENDING_REFERENCE'::wager_transaction_status])) AND (processed_at IS NULL) AND (failure_code IS NULL))",
          "definition": "CHECK ((((status = 'PROCESSED'::wager_transaction_status) AND (processed_at IS NOT NULL) AND (failure_code IS NULL)) OR ((status = ANY (ARRAY['REJECTED'::wager_transaction_status, 'FAILED'::wager_transaction_status])) AND (processed_at IS NULL) AND (failure_code IS NOT NULL)) OR ((status = ANY (ARRAY['PENDING'::wager_transaction_status, 'PENDING_REFERENCE'::wager_transaction_status])) AND (processed_at IS NULL) AND (failure_code IS NULL))))",
          "columnName": "failure_code"
        }
